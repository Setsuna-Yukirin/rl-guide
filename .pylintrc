[MASTER]
# 最大行长度
max-line-length=100

# 要检查的文件
jobs=0

[MESSAGES CONTROL]
# 禁用的检查
disable=
    C0114,  # missing-module-docstring
    C0116,  # missing-function-docstring
    R0903,  # too-few-public-methods
    W0511,  # fixme

[FORMAT]
# 最大行长度
max-line-length=100

[BASIC]
# 变量命名规则
variable-rgx=[a-z_][a-z0-9_]{2,30}$
# 函数命名规则
function-rgx=[a-z_][a-z0-9_]{2,30}$
# 类命名规则
class-rgx=[A-Z_][a-zA-Z0-9]+$

[DESIGN]
# 函数最大参数数
max-args=10
# 函数最大局部变量数
max-locals=20
# 函数最大分支数
max-branches=15
